{
  "format_version": "1.26.20",
  "minecraft:entity": {
    "description": {
      "identifier": "fluffyalien_asn:storage_interface_entity",
      "is_summonable": true,
      "is_spawnable": false,
      "properties": {
        "fluffyalien_asn:interactions_allowed": {
          "type": "bool",
          "default": true
        }
      }
    },
    "component_groups": {
      "fluffyalien_asn:interactable": {
        "minecraft:collision_box": {
          "width": 1,
          "height": 1
        }
      },
      "fluffyalien_asn:not_interactable": {
        "minecraft:collision_box": {
          "width": 0,
          "height": 0
        }
      }
    },
    "components": {
      "minecraft:inventory": {
        "container_type": "container",
        "inventory_size": 59
      },
      "minecraft:type_family": {
        "family": ["fluffyalien_asn:storage_viewer"]
      },
      "minecraft:persistent": {},
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:breathable": {
        "breathes_water": true
      },
      "minecraft:physics": {
        "has_gravity": false,
        "has_collision": false
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "deals_damage": "no"
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": ["fluffyalien_asn:interactable"]
        }
      },
      "fluffyalien_asn:allow_interactions": {
        "set_property": {
          "fluffyalien_asn:interactions_allowed": true
        },
        "remove": {
          "component_groups": ["fluffyalien_asn:not_interactable"]
        },
        "add": {
          "component_groups": ["fluffyalien_asn:interactable"]
        }
      },
      "fluffyalien_asn:block_interactions": {
        "set_property": {
          "fluffyalien_asn:interactions_allowed": false
        },
        "remove": {
          "component_groups": ["fluffyalien_asn:interactable"]
        },
        "add": {
          "component_groups": ["fluffyalien_asn:not_interactable"]
        }
      }
    }
  }
}
