{
  "namespace": "fluffyalien_asn:craft_form",

  "craft_form@fluffyalien_asn:common.form": {
    "$child_control": "fluffyalien_asn:craft_form.craft_form_panel",
    "size": [230, 235]
  },

  "craft_form_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%"],
    "orientation": "vertical",
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "scrolling_panel@common.scrolling_panel": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "$show_background": false,
          "size": ["100%", "100%"],
          "$scrolling_content": "fluffyalien_asn:craft_form.craft_form_scrolling_content",
          "$scroll_size": [5, "100% - 4px"],
          "$scrolling_pane_size": ["100% - 4px", "100% - 2px"],
          "$scrolling_pane_offset": [2, 0],
          "$scroll_bar_right_padding_size": [0, 0]
        }
      }
    ]
  },

  "craft_form_scrolling_content": {
    "type": "stack_panel",
    "size": ["100% - 4px", "100%c"],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "main_label": {
          "type": "label",
          "offset": [2, 2],
          "color": "$main_header_text_color",
          "size": ["100%", "default"],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "text": "#form_text"
        }
      },
      {
        "padding": {
          "type": "panel",
          "size": ["100%", 4]
        }
      },
      {
        "wrapping_panel": {
          "type": "panel",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": ["100%", "100%c"],
          "controls": [
            {
              "buttons@fluffyalien_asn:craft_form.craft_buttons_panel": {}
            }
          ]
        }
      }
    ]
  },

  "craft_buttons_panel": {
    "type": "stack_panel",
    "size": ["100% - 4px", "100%c"],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [4, 0],
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "fluffyalien_asn:craft_form.craft_button"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "craft_button": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%", "100%c"],
    "controls": [
      {
        "button_panel": {
          "type": "panel",
          "size": [36, 36],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            {
              "icon@fluffyalien_asn:common.form_button_icon": {
                "anchor_from": "top_left",
                "anchor_to": "top_left"
              }
            },
            {
              "form_button@common_buttons.light_text_button": {
                "$pressed_button_name": "button.form_button_click",
                "size": [32, 32],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ],
                "controls": [
                  {
                    "hover@$button_state_panel": {
                      "controls": [
                        {
                          "select_label@fluffyalien_asn:common.hover_text": {
                            "property_bag": {
                              "#hover_text": "Craft"
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "label": {
          "type": "label",
          "size": ["100%", "default"],
          "text": "#text",
          "layer": 2,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "#form_button_text",
              "target_property_name": "#text"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_button"
            }
          ]
        }
      }
    ]
  }
}
