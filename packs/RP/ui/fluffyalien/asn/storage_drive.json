{
  "namespace": "fluffyalien_asn:storage_drive",
  "root@fluffyalien_energisticscore:common_v2.screen_template": {
    "$content_ref": "fluffyalien_asn:storage_drive.content",
    "$root_panel_size": [176, 166]
  },
  "grid_item@chest.chest_grid_item": {
    "$cell_overlay_ref": "fluffyalien_asn:common.disk_placeholder"
  },
  "content@fluffyalien_energisticscore:common_v2.content_template": {
    "controls": [
      {
        "title@fluffyalien_energisticscore:common_v2.container_title": {
          "text": "tile.fluffyalien_asn:storage_drive_v3.name"
        }
      },
      {
        "grid@fluffyalien_asn:common.container_grid": {
          "size": [72, 36],
          "grid_dimensions": [4, 2],
          "offset": ["50%-36px", 19],
          "grid_item_template": "fluffyalien_asn:storage_drive.grid_item"
        }
      }
    ]
  }
}
