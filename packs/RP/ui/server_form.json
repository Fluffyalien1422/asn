{
  "long_form": {
    "controls": [
      {
        "default_long_form@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": ["100% - 15px", 10],
          "$title_max_size": ["100% - 15px", 10],
          "size": [225, 200],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(not (#title_text = 'fluffyalien_asn.ui.storageInterface.craft.title'))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "asn_craft_form@fluffyalien_asn:form.craft_form": {
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'fluffyalien_asn.ui.storageInterface.craft.title')",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
