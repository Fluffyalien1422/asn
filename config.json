{
  "$schema": "https://raw.githubusercontent.com/Bedrock-OSS/regolith-schemas/main/config/v1.4.json",
  "author": "Fluffyalien1422",
  "name": "asn",
  "packs": {
    "behaviorPack": "./packs/BP",
    "resourcePack": "./packs/RP"
  },
  "regolith": {
    "formatVersion": "1.4.0",
    "dataPath": "./packs/data",
    "filterDefinitions": {
      "simple_manifest_standalone": {
        "runWith": "shell",
        "command": "node --experimental-transform-types ../../scripts/filters/simple_manifest_standalone.ts"
      },
      "simple_manifest_bec": {
        "runWith": "shell",
        "command": "node --experimental-transform-types ../../scripts/filters/simple_manifest_bec.ts"
      },
      "build_details_standalone": {
        "runWith": "shell",
        "command": "Set-Content -Path BP/scripts/build_details.js -Value 'export const BUILD_DETAILS = { isBecBuild: false };' -Encoding UTF8"
      },
      "build_details_bec": {
        "runWith": "shell",
        "command": "Set-Content -Path BP/scripts/build_details.js -Value 'export const BUILD_DETAILS = { isBecBuild: true };' -Encoding UTF8"
      },
      "build_scripts": {
        "runWith": "shell",
        "command": "npx esbuild ./BP/scripts/index.ts --outfile=./BP/scripts/__bundle.js --bundle --format=esm --log-level=warning --external:@minecraft/server --external:@minecraft/server-ui --preserve-symlinks"
      },
      "minify_and_clean_scripts": {
        "runWith": "shell",
        "command": "npx terser ./BP/scripts/__bundle.js --module -cmo ./BP/scripts/__bundle.js; Remove-Item ./BP/scripts/* -Recurse -Exclude __bundle.js"
      },
      "page_number_items": {
        "runWith": "nodejs",
        "script": "scripts/filters/page_number_items.ts"
      },
      "remove_bec_files": {
        "runWith": "shell",
        "command": "Get-ChildItem BP -Filter *.bec.json -Recurse | Remove-Item"
      },
      "remove_bec_components": {
        "runWith": "nodejs",
        "script": "scripts/filters/remove_bec_components.js"
      }
    },
    "profiles": {
      "default": {
        "export": {
          "target": "development",
          "build": "standard"
        },
        "filters": [
          {
            "profile": "dev_bec"
          }
        ]
      },
      "dev_shared": {
        "export": {
          "target": "none"
        },
        "filters": [
          {
            "filter": "build_scripts"
          },
          {
            "filter": "page_number_items"
          }
        ]
      },
      "dev_standalone": {
        "export": {
          "target": "development",
          "build": "standard"
        },
        "filters": [
          {
            "filter": "simple_manifest_standalone"
          },
          {
            "filter": "build_details_standalone"
          },
          {
            "profile": "dev_shared"
          },
          {
            "filter": "remove_bec_files"
          },
          {
            "filter": "remove_bec_components"
          }
        ]
      },
      "dev_bec": {
        "export": {
          "target": "development",
          "build": "standard"
        },
        "filters": [
          {
            "filter": "simple_manifest_bec"
          },
          {
            "filter": "build_details_bec"
          },
          {
            "profile": "dev_shared"
          }
        ]
      },
      "prod_standalone": {
        "export": {
          "target": "local"
        },
        "filters": [
          {
            "profile": "dev_standalone"
          },
          {
            "filter": "minify_and_clean_scripts"
          }
        ]
      },
      "prod_bec": {
        "export": {
          "target": "local"
        },
        "filters": [
          {
            "profile": "dev_bec"
          },
          {
            "filter": "minify_and_clean_scripts"
          }
        ]
      }
    }
  }
}
